# Copy to .env.local for local development. None of these values are secrets:
# they are compiled into the public frontend. Real data is protected by
# Supabase row-level security and Microsoft sign-in, not by hiding these.

# Shared storage (Supabase). Leave empty to run in "This device only" mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Outlook 365 (Microsoft Entra app registration, SPA platform). Leave empty to hide Outlook.
VITE_MS_CLIENT_ID=
# Your organization's tenant ID (GUID) or "organizations".
VITE_MS_TENANT_ID=
